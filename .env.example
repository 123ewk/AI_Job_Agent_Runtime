# ==================== 应用配置 ====================
APP_NAME=AI Career Copilot
APP_ENV=dev
DEBUG=true
LOG_LEVEL=INFO

# ==================== PostgreSQL ====================
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=ai_career
POSTGRES_PASSWORD=change-me-in-prod
POSTGRES_DB=ai_career_dev

# ==================== Redis ====================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ==================== MinIO（对象存储） ====================
# 用途：简历文件、截图、执行证据
# endpoint 只写 host:port，不带协议；secure 决定 http/https
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=ai_career_minio
MINIO_SECRET_KEY=change-me-in-prod
MINIO_BUCKET=ai-career-assets
MINIO_SECURE=false
# 启动时若 bucket 不存在是否自动创建
MINIO_AUTO_CREATE_BUCKET=true

# ==================== JWT ====================
JWT_SECRET_KEY=changeme-to-a-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ==================== LLM ====================
OPENAI_API_KEY=
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
DEEPSEEK_API_KEY=
DEEPSEEK_API_BASE=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
MIMO_API_KEY=
MIMO_API_BASE=https://token-plan-cn.xiaomimimo.com/v1
MIMO_MODEL=mimo-v2.5
DOUBAO_MODEL=doubao-seed-2.0-pro
DOUBAO_API_KEY=
DOUBAO_API_BASE=https://ark.cn-beijing.volces.com/api/v3
# 当前使用的 LLM 提供商：doubao / deepseek / openai / mimo
LLM_PROVIDER=doubao

# ==================== Tavily Search ====================
TAVILY_API_KEY=
TAVILY_API_BASE=https://api.tavily.com
TAVILY_SEARCH_DEPTH=basic
TAVILY_MAX_RESULTS=5
TAVILY_TIMEOUT=15.0
TAVILY_MAX_RETRIES=3

# ==================== 文件上传 ====================
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=10

# ==================== CORS 跨域 ====================
# 精确白名单：Web 前端、第三方回调等固定域名
# 多个用英文逗号分隔，留空表示不额外放行（dev 环境会自动追加本地端口）
# CORS_ALLOW_ORIGINS=https://app.example.com,https://admin.example.com
CORS_ALLOW_ORIGINS=

# 是否放行浏览器扩展来源（chrome/moz/edge-extension://*）
# 开发环境：true；生产环境：建议 false 并配合 X-Extension-ID 二次校验
CORS_ALLOW_EXTENSIONS=true

# 是否允许携带 Cookie / Authorization 等凭据
CORS_ALLOW_CREDENTIALS=true

# 预检请求（OPTIONS）结果在浏览器侧缓存秒数
CORS_MAX_AGE_SECONDS=600

# ==================== 匹配模块（Step 1.7）====================
# BM25 与语义匹配的权重，和必须等于 1.0
MATCH_BM25_WEIGHT=0.4
MATCH_SEMANTIC_WEIGHT=0.6

# 句向量模型：支持 HuggingFace 模型名或本地绝对路径
# Windows 路径请使用双反斜杠或正斜杠，例如：
# SENTENCE_TRANSFORMER_MODEL="E:\\MoTa_model\\XiangLiang\\bge-small-zh-v1.5"
SENTENCE_TRANSFORMER_MODEL=BAAI/bge-small-zh-v1.5

# 是否启用语义匹配：false 时自动使用 NullEmbeddingBackend 降级
SEMANTIC_SCORER_ENABLED=true

# BM25 归一化缩放系数：越大，相同命中下的得分越低
MATCH_BM25_SCALE=5.0

# ==================== 浏览器桥（Chrome MCP Server） ====================
# 通道设计见 docs/AI求职Agent_设计文档_V2.0/17-ChromeMCPServer落地选型与实现.md
# 默认关闭：不开启时后端完全不带浏览器能力，不影响现有功能
BROWSER_MCP_ENABLED=false

# server 监听地址与端口（与 mcp-server/index.js 默认一致）
BROWSER_MCP_HOST=127.0.0.1
BROWSER_MCP_PORT=12307

# 令牌：与 mcp-server/token.js 一致（env 优先，否则回退 ~/.browser-mcp-secrets.json）。
# 留空时后端自动读取 ~/.browser-mcp-secrets.json，与扩展 popup 粘贴的令牌天然一致。
# 查看：cd mcp-server && node token.js --print
BROWSER_MCP_TOKEN=

# node 入口绝对路径；留空时按仓库根/mcp-server/index.js 推断
BROWSER_MCP_SERVER_PATH=

# 单次工具调用超时（秒）；超时 -> 重启 server -> 重试
BROWSER_MCP_TIMEOUT=30.0

# 健康检查周期（秒）
BROWSER_MCP_PING_INTERVAL=30.0

# 工具调用 URL 域名白名单（逗号分隔；chrome_navigate / 高风险工具使用）
BROWSER_MCP_URL_WHITELIST=zhipin.com

# 高危工具（需 Skill 级授权 + 审计日志），逗号分隔
BROWSER_MCP_RISK_TOOLS=chrome_javascript,chrome_network_request
